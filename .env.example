# ===== 必需（默认启动缺失任何一个即报错；若开启 --setup-ui 或 ALLOW_WEB_SETUP=true，仅强制要求 MYSQL_DSN）=====
# OpenAI 兼容对话 API 地址，如 https://api.deepseek.com/v1
LLM_BASE_URL=
# 对话 API Key
LLM_API_KEY=
# 对话模型名，如 deepseek-chat / gpt-4o-mini / qwen-plus
LLM_CHAT_MODEL=
# Embedding 向量模型名，如 text-embedding-v3 / text-embedding-3-small / bge-m3
LLM_EMBED_MODEL=
# MySQL 连接串（V3 独立库建议使用 knowledge_qa_v3）
MYSQL_DSN=root:knowledge_v3_pass@tcp(127.0.0.1:3306)/knowledge_qa_v3?charset=utf8mb4&parseTime=true

# ===== 可选：Embedding 单独走另一家平台 =====
# 不填则回落到 LLM_BASE_URL / LLM_API_KEY。
# 例：对话使用 DeepSeek，Embedding 单独使用阿里 DashScope 兼容接口。
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBED_API_KEY=

# ===== 可选：即插即用 Web 引导配置与演示初始化 =====
# 设为 true 时等价于 --setup-ui：仅需 MYSQL_DSN，缺失模型参数时也可先启动网页引导卡片（密钥仅存进程内存，不落盘）
ALLOW_WEB_SETUP=true
# Docker / 一键启动检测为空库且模型配置齐全时，自动幂等导入 corpus_v2 多格式演示语料
AUTO_SEED_DEMO=true
# Docker 容器内置 MySQL Root 密码占位符（请按需修改）
MYSQL_ROOT_PASSWORD=knowledge_v3_pass

# ===== 可选：HTTP 与多格式/重排扩展 =====
# HTTP 监听地址，默认 :8080
# HTTP_ADDR=:8080

# 文档格式转换引擎：native（默认纯 Go，零外部依赖） | markitdown（调用本机 markitdown CLI）
# CONVERT_ENGINE=native

# 可选：扫描件 PDF / 图片转 Markdown 的多模态模型（未配则在遇扫描件/图片时明确报错）
# LLM_VLM_MODEL=
# VLM_BASE_URL=
# VLM_API_KEY=

# 可选：Cross-Encoder 重排 API（阶段 11 实验证明当前基线上可能引发语义负迁移，默认留空关闭）
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_MODEL=gte-rerank-v2
