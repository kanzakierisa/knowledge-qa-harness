# ===== 必需（缺任何一个启动即报错并提示缺哪个）=====
# OpenAI 兼容 API 地址，如 https://api.deepseek.com/v1
LLM_BASE_URL=
# 对话 API key
LLM_API_KEY=
# 对话模型名，如 deepseek-chat / gpt-4o-mini / qwen-plus
LLM_CHAT_MODEL=
# embedding 模型名，如 text-embedding-v3 / text-embedding-3-small / bge-m3
LLM_EMBED_MODEL=
# MySQL 连接串，V2 建议使用独立库 knowledge_qa_v2，如 root:password@tcp(127.0.0.1:3306)/knowledge_qa_v2?charset=utf8mb4&parseTime=true
MYSQL_DSN=

# ===== 可选：embedding 单独走另一家平台 =====
# 不填则回落到 LLM_BASE_URL / LLM_API_KEY。
# 例：对话用 DeepSeek（无 embedding 接口），embedding 用阿里 DashScope。
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBED_API_KEY=

# ===== 可选：HTTP 与 V2 多格式/重排扩展 =====
# HTTP 监听地址，不填写时为 :8080；端口已占用时可指定其他端口。
# HTTP_ADDR=

# 文档格式转换引擎：native（默认纯 Go，零外部依赖） | markitdown（调用本机 markitdown CLI）
# CONVERT_ENGINE=native

# 可选：扫描件 PDF / 图片转 Markdown 的多模态模型名（未配则在遇扫描件/图片时明确报错，不乱码入库）
# LLM_VLM_MODEL=
# VLM_BASE_URL=
# VLM_API_KEY=

# 可选：Cross-Encoder 重排 API（阶段 11 实验启用，未配则跳过重排）
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_MODEL=
